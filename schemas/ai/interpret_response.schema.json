{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interpret Response",
  "type": "object",
  "required": [
    "schema_version",
    "processing_version",
    "decision",
    "confidence",
    "needs_human_review",
    "facts",
    "commitments",
    "questions_answered",
    "conflicts",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "processing_version": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "needs_human_review": {
      "type": "boolean"
    },
    "facts": {
      "type": "array"
    },
    "commitments": {
      "type": "array"
    },
    "questions_answered": {
      "type": "array"
    },
    "conflicts": {
      "type": "array"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
