{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Match Case",
  "type": "object",
  "required": [
    "schema_version",
    "processing_version",
    "decision",
    "confidence",
    "needs_human_review",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "processing_version": {
      "type": "string"
    },
    "decision": {
      "type": "string",
      "enum": [
        "MATCH_EXISTING_CASE",
        "CREATE_NEW_CASE",
        "DUPLICATE_MESSAGE",
        "RELATED_CASE",
        "AMBIGUOUS_HUMAN_REVIEW"
      ]
    },
    "matched_case_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": "string"
    },
    "needs_human_review": {
      "type": "boolean"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
